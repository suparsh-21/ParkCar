# ParkKar Frontend Configuration

# Google Maps API Key (Used for interactive Google Maps, location pins, and places)
# If omitted, ParkKar automatically activates its built-in interactive Radar and coordinate view
VITE_GOOGLE_MAPS_API_KEY=

# Public Razorpay Key ID (Optional fallback if backend doesn't supply it during order creation)
VITE_RAZORPAY_KEY_ID=
